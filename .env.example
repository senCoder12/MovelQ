# Neon PostgreSQL
NEON_DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require

# Neon's DIRECT (non-pooled, no "-pooler" in the host) connection string.
# Required for LISTEN/NOTIFY -- see db/09_alert_stream_trigger.sql and
# app/infrastructure/alert_listener.py. The pooled URL above will not
# reliably deliver NOTIFYs.
NEON_DIRECT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM Configuration
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Application
APP_NAME=moveiq
APP_PORT=8000
DEMO_MODE=true

# Analytics Configuration
ALERT_EPISODE_GAP_MINUTES=15
SITUATION_TIME_WINDOW_HOURS=4
READINESS_THRESHOLD_WARNING=0.85
READINESS_THRESHOLD_CRITICAL=0.75
MATERIAL_CHANGE_THRESHOLD_PP=5
BASELINE_LOOKBACK_DAYS=30

# LLM Cost Controls
LLM_CACHE_TTL_SECONDS=3600
LLM_MAX_CALLS_PER_HOUR=100

# Replay
REPLAY_SPEED=1.0
REPLAY_DEFAULT_DATE=2026-07-15
