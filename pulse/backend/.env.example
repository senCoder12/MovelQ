# Pulse backend configuration.
#
# Copy to backend/.env and fill in the real value. backend/.env is gitignored --
# it is the only place credentials live. Nothing here is a real secret.

# Paste the postgres:// URI exactly as Neon gives it. The app splits it at
# startup: host and database into the JDBC URL, credentials into separate JDBC
# properties. Credentials stay out of the URL on purpose -- the URL is what turns
# up in connection errors, Flyway output and startup logs. channel_binding is
# dropped automatically; the JDBC driver rejects it.
NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Or set these directly. They win over NEON_DATABASE_URL.
# PULSE_DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# PULSE_DB_USER=<user>
# PULSE_DB_PASSWORD=<password>

AGENT_BASE_URL=http://localhost:8000

# Optional. DuckDB analytical warehouse, checked (read-only) by /api/health.
# Relative paths resolve from the directory the app runs in (pulse/).
# PULSE_WAREHOUSE_PATH=data/warehouse.duckdb
