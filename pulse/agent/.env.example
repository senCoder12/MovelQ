# Pulse agent configuration
APP_NAME=pulse-agent
HOST=0.0.0.0
PORT=8000

# DuckDB warehouse (relative paths resolve from the repo root)
DUCKDB_PATH=data/warehouse.duckdb

# Raw hackathon CSVs
RAW_DATA_DIR=data/raw

# LLM: Google Gemini. Required for the leadership-pack narrative -- without
# it the pack still renders, but degrades to the no-prose template fallback.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-pro

# Platform database (Postgres), for the token ledger and the cost query.
# Normally left blank here: backend/.env is loaded automatically and already
# holds NEON_DATABASE_URL. Set these only to point the agent somewhere else.
# NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# PULSE_DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# PULSE_DB_USER=<user>
# PULSE_DB_PASSWORD=<password>
